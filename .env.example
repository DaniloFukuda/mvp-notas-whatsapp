WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=meu_token_de_verificacao
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEST_RECIPIENT_PHONE=
# Habilita diagnostico estruturado extra da camada Meta/WhatsApp.
# O cliente centralizado e a classificacao de erros ficam ativos por padrao.
WHATSAPP_RELIABILITY_ENABLED=false
BASE_PUBLIC_URL=

WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
WHISPER_MAX_AUDIO_MB=50
WHISPER_MAX_AUDIO_SECONDS=1800
WHISPER_CHUNK_SECONDS=60
WHISPER_PREPROCESS_AUDIO=true
WHISPER_TEMPERATURE=0
WHISPER_INITIAL_PROMPT=Transcrição em português do Brasil. Termos possíveis: WhatsApp, Codex, OpenAI, ChatGPT, Python, Git, branch, commit, pull request, deploy, servidor, webhook, Ciclus, OLT, contentor, aluguer, RDV, visita técnica.
WHISPER_KEEP_FAILED_AUDIO=true
TRANSCRIPTION_REVIEW_ENABLED=true
TRANSCRIPTION_REVIEW_PROVIDER=local
TRANSCRIPTION_REVIEW_MODE_DEFAULT=revisada
TRANSCRIPTION_LLM_REVIEW_ENABLED=false
TRANSCRIPTION_LLM_PROVIDER=openai
TRANSCRIPTION_LLM_MODEL=gpt-5.4-mini
TRANSCRIPTION_LLM_TIMEOUT_SECONDS=20
TRANSCRIPTION_LLM_MAX_INPUT_CHARS=12000

VISITA_DESCRICAO_MAX_CHARS=5000
VISITA_OBSERVACAO_MAX_CHARS=20000
VISITA_OBSERVACAO_TOTAL_MAX_CHARS=80000
FOTO_COMENTARIO_MAX_CHARS=2000

SPACES_ENABLED=false
SPACES_REGION=sfo3
SPACES_BUCKET=lucre-agro-midias
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_PUBLIC_BASE_URL=https://lucre-agro-midias.sfo3.digitaloceanspaces.com

SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

VIDEO_MAX_MB=15
VIDEO_MAX_SECONDS=15
# Limite configuravel de videos por visita tecnica.
VIDEO_MAX_PER_VISITA=10

# Resumo de visita tecnica agricola (infra isolada, modulo 1).
# Fica desativado por padrao; nenhuma chamada de IA ocorre nesta etapa.
VISITA_SUMMARY_ENABLED=false
VISITA_SUMMARY_MAX_INPUT_CHARS=12000
ASSISTENTE_INTELIGENTE_ENABLED=false

# Assistente Inteligente Ciclus - conversa isolada (modulo 2A).
# Provider mock por padrao; nenhuma chamada a Hermes/OpenAI ocorre nesta etapa.
# Sem URL, token ou chave ainda. Valores ausentes usam defaults seguros.
ASSISTENTE_INTELIGENTE_PROVIDER=mock
ASSISTENTE_INTELIGENTE_TIMEOUT_SECONDS=20
ASSISTENTE_INTELIGENTE_MAX_INPUT_CHARS=2000
ASSISTENTE_INTELIGENTE_MAX_HISTORY_TURNS=6
