server {
    listen 80;
    server_name ciclus.fukudasistemas.com.br;

    client_max_body_size 50m;

    # A Meta precisa acessar esta rota sem Basic Auth.
    location = /webhook/whatsapp {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health somente para verificacoes internas na VPS.
    location = /health {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8001;
    }

    location ~ /\.(env|git) {
        deny all;
    }

    location ~* /(data|backups|uploads)/ {
        deny all;
    }

    location / {
        auth_basic "Acesso restrito";
        auth_basic_user_file /etc/nginx/.htpasswd-ciclus;

        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Depois de o DNS apontar para a VPS, execute o Certbot com o plugin do Nginx.
# O Certbot adiciona automaticamente os blocos SSL e caminhos reais dos
# certificados. Nao versione chaves privadas nem arquivos de /etc/letsencrypt.
